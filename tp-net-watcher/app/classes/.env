# ====== APP API SETTING ======

HOST_VERSION=1.0.0
HOST_FROM_PREFIX=tp-net-watcher
APP_API_PORT=1882
DEBUG_MODE_RESPONSE_CODE=true

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_USERNAME=
MQTT_OPT_PASSWORD=

# SUB CHANNEL (Services/Facade/MqttService.java) Need flexible identify (prefix + host id or host id only)
MQTT_SUBSCRIBE_TOPIC=winwtsvc/# 

# listening topic: winwtsvc/:hostId/# for agents or winwtsvc/:hostId-:hostDeviceType/# for nodes
# sub agent = winwtsvc/128/#
# sub node = winwtsvc/128-node-server-01/#

# PUB CHANNEL (CommandHandler/Modules) Need :hostIdentifier ~ :hostFromPrefix-:hostId-:hostHwid
MQTT_CLIENT_CONTROL_TOPIC=winatsvc/:hostIdentifier/control
MQTT_NODE_CONTROL_TOPIC=winttsvc/:hostIdentifier/control

# control topic: hostIdentifier = :hostFromPrefix-:hostId-:hostHwid on client or node
# pub agent = winatsvc/tp-net-agent-128-12F20543/trigger
# pub trigger = winttsvc/tp-net-trigger-128-12F20543/trigger

MQTT_SIGNAL_TARGET_KEY=watcher:facade

# ====== REDIS SERVICE ======

REDIS_SERVER_PORT=6379
REDIS_SERVER_HOST=localhost

REDIS_POOL_WORKER_PREFIX=worker
REDIS_POOL_NAMED_THREAD_PREFIX=thread
REDIS_POOL_THREAD_HEARTBEAT_EXPIRE=10
REDIS_POOL_THREAD_HEARTBEAT_INTERVAL=5000
REDIS_POOL_WORKER_COUNT=16

REDIS_POOL_CONFIG_MAX_TOTAL=16
REDIS_POOL_CONFIG_MAX_IDLE=16
REDIS_POOL_CONFIG_MIN_IDLE=16

REDIS_JOB_PREFIX_NAME=job
REDIS_JOB_QUEUED_EXPIRED_TIME=60
REDIS_JOB_PENDING_EXPIRED_TIME=60
REDIS_JOB_PROCESSING_EXPIRED_TIME=60
REDIS_JOB_DONE_EXPIRED_TIME=60
REDIS_JOB_FAILED_EXPIRED_TIME=60

# ====== HOST WAKEONLAN SERVICE ======

LAN_HOST_MAP_FILE=host_map.list.json