# ====== APP API SETTING ======

APP_API_PORT=1882
HOST_FROM_PREFIX=java-node-watcher
HOST_VERSION=0.0.1
DEBUG_MODE_RESPONSE_CODE=true

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_CLEAN_SESSION=true
MQTT_OPT_CONNECTION_TIMEOUT=30
MQTT_OPT_KEEP_ALIVE=60
MQTT_OPT_FALLBACK_QOS=0

MQTT_RUNTIME_TOPIC=winsv_wtpsvn/:hostId/runtime
MQTT_PROFILE_TOPIC=winsv_wtpsvn/:hostId/profile
MQTT_HEALTH_TOPIC=winsv_wtpsvn/:hostId/health
MQTT_SENSOR_TOPIC=winsv_wtpsvn/:hostId/sensor
MQTT_SYSTEM_TOPIC=winsv_wtpsvn/:hostId/system
MQTT_SIGNAL_TOPIC=winsv_ftpsvn/:hostId/signal

MQTT_CONTROL_TOPIC=winsv_atpsvn/:hostId/control

MQTT_SIGNAL_TARGET_KEY=watacher:facade

# ====== REDIS SERVICE ======

REDIS_SERVER_PORT=6379
REDIS_SERVER_HOST=localhost

REDIS_POOL_WORKER_PREFIX=worker
REDIS_POOL_NAMED_THREAD_PREFIX=thread
REDIS_POOL_THREAD_HEARTBEAT_EXPIRE=10
REDIS_POOL_THREAD_HEARTBEAT_INTERVAL=5000
REDIS_POOL_WORKER_COUNT=16

REDIS_POOL_CONFIG_MAX_TOTAL=16
REDIS_POOL_CONFIG_MAX_IDLE=16
REDIS_POOL_CONFIG_MIN_IDLE=16

REDIS_JOB_PREFIX_NAME=job
REDIS_JOB_QUEUED_EXPIRED_TIME=60
REDIS_JOB_PENDING_EXPIRED_TIME=60
REDIS_JOB_PROCESSING_EXPIRED_TIME=60
REDIS_JOB_DONE_EXPIRED_TIME=60
REDIS_JOB_FAILED_EXPIRED_TIME=60

# ====== HOST WAKEONLAN SERVICE ======

LAN_HOST_MAP_FILE=host_map.list.json